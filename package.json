{
  "name": "glass-ui",
  "version": "0.1.0",
  "description": "A glassmorphism design system for React: one physical model shared by buttons, surfaces and motion. Archived at pre-v1.0.",
  "author": "Eren Deniz Kuyucaklıoğlu",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --config vite.playground.config.ts",
    "playground": "vite --config vite.playground.config.ts",
    "build": "vite build",
    "prepare": "npm run build",
    "build:site": "vite build --config vite.playground.config.ts",
    "preview:site": "vite preview --config vite.playground.config.ts",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.0"
  },
  "peerDependencies": {
    "framer-motion": "^11.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.1.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "framer-motion": "^11.0.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^1.2.0"
  },
  "keywords": [
    "react",
    "glassmorphism",
    "ui-components",
    "design-system",
    "material-design",
    "typescript",
    "tailwind-css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErenDenizK/glass-ui.git"
  },
  "homepage": "https://github.com/ErenDenizK/glass-ui#readme",
  "bugs": {
    "url": "https://github.com/ErenDenizK/glass-ui/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true
}
